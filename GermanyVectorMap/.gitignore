# OSM input extracts — download with scripts/fetch_data.sh, never commit
input/*.osm.pbf
input/*.osm.pbf.md5
input/*.part

# generated tilesets
output/*.mbtiles
output/*.pmtiles
output/*.layerstats.tsv.gz
output/*.stats.json

# SVG exports ARE committed — they are the hand-off to Figma and are meant to be
# browsable (and previewable) straight from the repo. Published by
# .github/workflows/publish-svgs.yml; regenerate locally with scripts/export_svg.py.
exports/*.png
exports/*.zip

# downloaded / compiled tooling
tools/*.jar
tools/*.part
tools/node_modules/
tools/package*.json

# Planetiler scratch space
.tmp/
data/

__pycache__/
*.pyc
